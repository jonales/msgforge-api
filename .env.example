# Configuração do Msgforge API (veja a tabela no README)
SERVER_URL=http://localhost:8080
# Obrigatória: 32+ caracteres aleatórios (ex.: openssl rand -hex 32). Sem ela, a aplicação não sobe.
# A chave padrão (troque-esta-chave) só é aceita com SPRING_PROFILES_ACTIVE=dev, nunca em produção.
AUTHENTICATION_API_KEY=
AUTHENTICATION_MAX_FAILURES=30         # erros de chave por IP em 15 min antes do 429 (0 desliga)
# Atrás de proxy reverso: CIDRs dos proxies confiáveis, separados por vírgula (ex.: 172.18.0.0/16).
# Só deles o X-Forwarded-For é aceito; vazio = cabeçalho ignorado (docs/configuracao.md)
TRUSTED_PROXIES=

DATABASE_URL=jdbc:postgresql://localhost:5432/msgforge
DATABASE_USER=msgforge
DATABASE_PASSWORD=msgforge

CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE_NAME=msgforge_exchange
# Eventos publicados, separados por vírgula (vazio = todos)
RABBITMQ_EVENTS=

WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
# Eventos do webhook global, separados por vírgula (vazio = todos). PRESENCE_UPDATE e CONTACTS_* vêm em volume
WEBHOOK_GLOBAL_EVENTS=

# Entrega de webhooks: timeout por tentativa e retry exponencial (rede, 408, 429, 5xx)
WEBHOOK_REQUEST_TIMEOUT_MS=10000
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INITIAL_DELAY_MS=1000
WEBHOOK_RETRY_MAX_DELAY_MS=30000
# Entregas aguardando por instância na fila em memória (só com OUTBOX_ENABLED=false)
WEBHOOK_MAX_PENDING_PER_INSTANCE=1000
# Outbox no PostgreSQL (ADR 0012): entregas sobrevivem a uma queda; false = fila em memória
OUTBOX_ENABLED=true
OUTBOX_RETENTION_HOURS=24              # apaga as entregas feitas depois de N horas (0 = guarda)
# true = webhooks de instância não podem apontar para IP privado/loopback/link-local (SSRF)
WEBHOOK_BLOCK_PRIVATE_NETWORKS=false

# stub = sem WhatsApp real (desenvolvimento); cobalt = conexão real (ADR 0007, use número de teste)
MSGFORGE_GATEWAY=stub

# Motor Cobalt
CONFIG_SESSION_PHONE_CLIENT=Msgforge   # nome em "Aparelhos conectados" no celular
COBALT_QR_WAIT_MS=10000                # quanto o /instance/connect espera pelo primeiro QR
COBALT_SEND_TIMEOUT_MS=30000
COBALT_MEDIA_MAX_BYTES=67108864
COBALT_PROXY=                          # http://, https:// ou socks5:// (vazio = conexão direta)
# Versão do WhatsApp Web (vazio = lida de web.whatsapp.com/sw.js); fixe só se o login falhar com 405
COBALT_WEB_VERSION=
# DEBUG = registra os nós do protocolo (só atributos), para diagnóstico
# LOGGING_LEVEL_DEV_MSGFORGE_GATEWAY_COBALT_WIRE=DEBUG

# Histórico de mensagens no banco (/chat/findMessages e /chat/findChats)
DATABASE_SAVE_DATA_NEW_MESSAGE=true
HISTORY_RETENTION_DAYS=0               # apaga mensagens mais velhas que N dias (0 = guarda para sempre)

# Mídia (ffmpeg: já vem na imagem Docker)
FFMPEG_PATH=ffmpeg
MEDIA_TRANSCODE_TIMEOUT_MS=60000
